# 운영 빌드(웹 정적 사이트 · 아이폰 앱)에서 공통으로 쓰는 값.
#
# NEXT_PUBLIC_* 는 '빌드 시점'에 코드에 박힌다. 그래서 앱을 빌드할 때 이 값이
# 비어 있으면 앱이 localhost:8080 을 보게 되고, 폰에서는 아무것도 안 뜬다.
# render.yaml 이 주는 환경변수가 더 우선하므로 웹 배포와 충돌하지 않는다.
#
# 여기 있는 값은 전부 공개되는 값이다(앱 번들·웹 번들에 그대로 들어간다).
# 비밀은 절대 넣지 말 것.

NEXT_PUBLIC_API_BASE=https://muruk-backend.onrender.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=799206979966-2lnqig1fc0unf4g7j2q44mll6kg4sn1f.apps.googleusercontent.com

# 아이폰 앱 전용 구글 클라이언트 ID.
# 구글 클라우드 콘솔 ▸ 사용자 인증 정보 ▸ OAuth 클라이언트 ID 만들기 ▸ 유형 'iOS'
# 번들 ID 는 com.muruk.app 로 맞춘다. 만든 뒤 아래 '여기에...' 를 교체하고,
# ios/App/App/Info.plist 의 CFBundleURLSchemes 도 같은 값(역순)으로 바꿔야 한다.
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=여기에_아이폰_클라이언트_ID.apps.googleusercontent.com
