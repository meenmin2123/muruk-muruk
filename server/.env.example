# 복사해서 .env 로 쓰거나, 실행 시 앞에 붙여 넣으세요.
# NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 구글 로그인 + 사용자별 데이터 분리를 켜려면 ↓ (없으면 단일 사용자 모드)
# GOOGLE_CLIENT_ID=여기에_구글_OAuth_클라이언트_ID.apps.googleusercontent.com
# (선택) 노션 두 DB의 사용자 구분용 텍스트 속성 이름 (기본: 사용자)
# USER_PROP=사용자

# (선택) 데이터소스 ID 교체할 때만:
# DREAM_DS=a88b9e89-2dbc-4e42-ad0c-1594636a003a
# TODO_DS=da4f4b25-a21a-46d9-9ede-9a8ad0be6eaa
# PORT=8787
