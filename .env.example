# docker compose 용 환경변수. 복사해서 .env 로 쓰세요.
ANTHROPIC_API_KEY=sk-ant-여기에
GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID.apps.googleusercontent.com
POSTGRES_PASSWORD=change-me
# 프론트가 접속할 백엔드 주소 (브라우저 기준). 로컬은 그대로 두면 됨.
NEXT_PUBLIC_API_BASE=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
# (선택) 노션 백업 — 중계 서버 방식
NOTION_RELAY_URL=
# (선택) 노션 백업 — 직접 연결 방식 (둘 다 채우면 Notion API로 바로 백업)
#   - NOTION_TOKEN: 노션 내부 통합(Integration) 시크릿 (secret_...)
#   - NOTION_DATABASE_ID: 백업 대상 데이터베이스 ID
#   - DB 속성 필요: Name(title), UserId(rich_text), UpdatedAt(date), Streak(number), Stickers(number)
NOTION_TOKEN=
NOTION_DATABASE_ID=
